ENVIRONMENT=development
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/investimentos_dev

# Obrigatório fora de development/test: a aplicação não sobe com o valor
# padrão (ele está no código-fonte). Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORT_HMAC_SECRET=

# A API não tem autenticação (single-user). Estas duas listas (JSON) são a
# fronteira de segurança — mantenha o servidor em 127.0.0.1 e só libere o
# que for realmente usar.
# ALLOWED_HOSTS=["localhost", "127.0.0.1"]
# CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Tamanho máximo de um arquivo de importação, em bytes (padrão 10 MB).
# IMPORT_MAX_UPLOAD_BYTES=10485760
